<?xml version="1.0" encoding="UTF-8" ?>
<project name="Sendal Business Management System" database="LogicalDesign" id="db45e02c-0b01-4ba9-921c-07cda75c1eed" >
	<schema name="Sendal Business Management System" >
		<table name="bill" prior="bi" >
			<column name="id" type="UUID" mandatory="y" />
			<column name="issue_datetime" type="DATETIME" mandatory="y" />
			<column name="status" type="VARCHAR" length="50" mandatory="y" />
			<column name="seller_id" type="UUID" mandatory="y" />
			<column name="buyer_id" type="UUID" mandatory="y" />
			<column name="notes" type="VARCHAR" length="600" />
			<column name="warranty" type="VARCHAR" length="255" />
			<column name="amount" type="NUMERIC" length="12" decimal="2" mandatory="y" />
			<column name="discount_amount" type="NUMERIC" length="12" decimal="2" />
			<index name="pk_bill" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
			<fk name="fk_bill_buyer" to_schema="Sendal Business Management System" to_table="buyer" type="NonIdentifying" mandatory="y" cardinality="ZeroMore" range_from="0" range_to="0" >
				<fk_column name="buyer_id" pk="id" />
			</fk>
			<fk name="fk_bill_user" to_schema="Sendal Business Management System" to_table="user" type="NonIdentifying" mandatory="y" cardinality="ZeroMore" range_from="0" range_to="0" >
				<fk_column name="seller_id" pk="id" />
			</fk>
		</table>
		<table name="buyer" prior="buye" >
			<column name="id" type="UUID" mandatory="y" />
			<column name="name" type="VARCHAR" length="250" mandatory="y" />
			<column name="phone_number" type="VARCHAR" length="30" mandatory="y" />
			<column name="type" type="VARCHAR" length="50" mandatory="y" />
			<column name="remaining_amount_due" type="NUMERIC" length="12" decimal="2" />
			<index name="pk_buyer" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
		</table>
		<table name="buying_price_history" prior="buying_price_histor" >
			<column name="id" type="UUID" mandatory="y" />
			<column name="product_id" type="UUID" mandatory="y" />
			<column name="buying_price_per_each" type="NUMERIC" mandatory="y" />
			<column name="datetime_of_price_update" type="DATETIME" mandatory="y" />
			<column name="user_id" type="UUID" mandatory="y" />
			<index name="pk_buying_price_history" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
			<fk name="fk_buying_price_history_product" to_schema="Sendal Business Management System" to_table="product" type="NonIdentifying" mandatory="y" cardinality="ZeroMore" range_from="0" range_to="0" >
				<fk_column name="product_id" pk="id" />
			</fk>
			<fk name="fk_buying_price_history_user" to_schema="Sendal Business Management System" to_table="user" type="NonIdentifying" mandatory="y" cardinality="ZeroMore" range_from="0" range_to="0" >
				<fk_column name="user_id" pk="id" />
			</fk>
		</table>
		<table name="cash_movement" prior="cash_move" >
			<column name="id" type="UUID" mandatory="y" />
			<column name="date_time" type="DATETIME" mandatory="y" />
			<column name="amount" type="NUMERIC" length="12" decimal="2" mandatory="y" />
			<column name="type" type="BOOLEAN" mandatory="y" />
			<column name="direction" type="VARCHAR" length="50" mandatory="y" />
			<column name="user_id" type="UUID" mandatory="y" />
			<column name="cash_drawer_balance" type="NUMERIC" length="12" decimal="2" mandatory="y" />
			<column name="bill_id" type="UUID" mandatory="y" />
			<index name="pk_cash_movement" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
			<fk name="fk_cash_movement_user" to_schema="Sendal Business Management System" to_table="user" type="NonIdentifying" mandatory="y" cardinality="ZeroMore" range_from="0" range_to="0" >
				<fk_column name="user_id" pk="id" />
			</fk>
			<fk name="fk_cash_movement_bill" to_schema="Sendal Business Management System" to_table="bill" type="NonIdentifying" mandatory="y" cardinality="ZeroMore" range_from="0" range_to="0" >
				<fk_column name="bill_id" pk="id" />
			</fk>
		</table>
		<table name="payment_history" prior="payment_histor" >
			<column name="id" type="UUID" mandatory="y" />
			<column name="amount" type="NUMERIC" length="12" decimal="2" mandatory="y" />
			<column name="payment_method" type="VARCHAR" length="50" mandatory="y" />
			<column name="datetime" type="DATETIME" mandatory="y" />
			<column name="bill_id" type="UUID" mandatory="y" />
			<index name="pk_payment_history" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
			<fk name="fk_payment_history_bill" to_schema="Sendal Business Management System" to_table="bill" type="NonIdentifying" mandatory="y" cardinality="ZeroMore" range_from="0" range_to="0" >
				<fk_column name="bill_id" pk="id" />
			</fk>
		</table>
		<table name="product" prior="produc" >
			<column name="id" type="UUID" mandatory="y" />
			<column name="name" type="VARCHAR" length="250" mandatory="y" />
			<column name="code" type="VARCHAR" length="50" mandatory="y" />
			<column name="active" type="BOOLEAN" mandatory="y" />
			<column name="type" type="VARCHAR" length="100" mandatory="y" />
			<column name="stock" type="INT" mandatory="y" />
			<index name="pk_product" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
			<index name="unq_product" unique="UNIQUE_KEY" >
				<column name="code" />
			</index>
		</table>
		<table name="selling_price_history" prior="buying_price_history_0" >
			<column name="id" type="UUID" mandatory="y" />
			<column name="product_id" type="UUID" mandatory="y" />
			<column name="selling_price_per_each" prior="buying_price_per_each" type="NUMERIC" mandatory="y" />
			<column name="datetime_of_price_update" type="DATETIME" mandatory="y" />
			<column name="user_id" type="UUID" mandatory="y" />
			<index name="pk_buying_price_history_0" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
			<fk name="fk_buying_price_history_product_0" to_schema="Sendal Business Management System" to_table="product" type="NonIdentifying" mandatory="y" cardinality="ZeroMore" range_from="0" range_to="0" >
				<fk_column name="product_id" pk="id" />
			</fk>
			<fk name="fk_selling_price_history_user" to_schema="Sendal Business Management System" to_table="user" type="NonIdentifying" mandatory="y" cardinality="ZeroMore" range_from="0" range_to="0" >
				<fk_column name="user_id" pk="id" />
			</fk>
		</table>
		<table name="sold_item" prior="sold_ite" >
			<column name="id" type="UUID" mandatory="y" />
			<column name="product_id" type="UUID" mandatory="y" />
			<column name="bill_id" type="UUID" mandatory="y" />
			<column name="quentity" type="INT" mandatory="y" />
			<column name="price_per_each" type="NUMERIC" length="12" decimal="2" mandatory="y" />
			<index name="pk_sold_item" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
			<fk name="fk_sold_item_bill" to_schema="Sendal Business Management System" to_table="bill" type="NonIdentifying" mandatory="y" cardinality="ZeroMore" range_from="0" range_to="0" >
				<fk_column name="bill_id" pk="id" />
			</fk>
			<fk name="fk_sold_item_product" to_schema="Sendal Business Management System" to_table="product" type="NonIdentifying" mandatory="y" cardinality="ZeroMore" range_from="0" range_to="0" >
				<fk_column name="product_id" pk="id" />
			</fk>
		</table>
		<table name="stock_movement" prior="stock_movemen" >
			<column name="id" type="UUID" mandatory="y" />
			<column name="direction" type="VARCHAR" length="50" mandatory="y" />
			<column name="type" type="BOOLEAN" mandatory="y" />
			<column name="quantity" type="INT" mandatory="y" />
			<column name="product_id" type="UUID" mandatory="y" />
			<column name="user_id" type="UUID" mandatory="y" />
			<column name="bill_id" type="UUID" mandatory="y" />
			<index name="pk_stock_movement" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
			<fk name="fk_stock_movement_product" to_schema="Sendal Business Management System" to_table="product" type="NonIdentifying" mandatory="y" cardinality="ZeroMore" range_from="0" range_to="0" >
				<fk_column name="product_id" pk="id" />
			</fk>
			<fk name="fk_stock_movement_user" to_schema="Sendal Business Management System" to_table="user" type="NonIdentifying" mandatory="y" cardinality="ZeroMore" range_from="0" range_to="0" >
				<fk_column name="user_id" pk="id" />
			</fk>
			<fk name="fk_stock_movement_bill" to_schema="Sendal Business Management System" to_table="bill" type="NonIdentifying" mandatory="y" cardinality="ZeroMore" range_from="0" range_to="0" >
				<fk_column name="bill_id" pk="id" />
			</fk>
		</table>
		<table name="user" prior="use" >
			<column name="id" type="UUID" mandatory="y" />
			<column name="username" type="VARCHAR" length="100" mandatory="y" />
			<column name="password_hashed" prior="hashed_password" type="VARCHAR" length="255" mandatory="y" />
			<column name="role" type="VARCHAR" length="50" mandatory="y" />
			<column name="name" type="VARCHAR" length="100" mandatory="y" />
			<column name="start_date" type="DATE" />
			<column name="salary" type="NUMERIC" length="12" decimal="2" />
			<column name="mobile_number" type="VARCHAR" length="30" />
			<index name="pk_use" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
		</table>
	</schema>
